# ==============================================================================
# Fast Rider — configuration (copy to .env and fill in ALL values)
# ==============================================================================
# cp .env.example .env
#
# Injected at compile time:
#   flutter run --dart-define-from-file=.env
#   flutter build ios --dart-define-from-file=.env
#
# All values are REQUIRED — the app will not start without them.
# See lib/config/app_config.dart for details.
# ==============================================================================

# Backend ride API base URL
API_BASE_URL=

# Geocoding endpoint (Nominatim-compatible /search)
GEOCODING_URL=

# Routing endpoint (OSRM-compatible)
ROUTING_URL=

# User-Agent sent to OSM providers (required by their usage policy)
MAPS_USER_AGENT=

# Attribution text for the geocoding provider (required by Nominatim)
GEOCODING_ATTRIBUTION=

# Attribution text for the routing provider (required by OSRM)
ROUTING_ATTRIBUTION=
