# ==============================================================================
# Fast Rider — optional provider overrides
# ==============================================================================
# cp .env.example .env
#
# Injected at compile time:
#   flutter run --dart-define-from-file=.env
#   flutter build ios --dart-define-from-file=.env
#
# These non-secret defaults already work without this file. Change only when
# using compatible self-hosted providers.
# ==============================================================================

# Geocoding endpoint (Nominatim-compatible /search)
GEOCODING_URL=https://nominatim.openstreetmap.org/search

# Routing endpoint (OSRM-compatible)
ROUTING_URL=https://router.project-osrm.org

# Raster tile URL. The {z}, {x}, and {y} placeholders are required.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# User-Agent sent to OSM providers (required by their usage policy)
MAPS_USER_AGENT=com.guilhermelino.fastrider/1.0.0
